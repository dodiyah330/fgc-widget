{
  "name": "fgc-widget",
  "version": "0.0.1",
  "description": "FGC Widget App/Web evolutius",
  "productName": "FGC Widget APP",
  "author": "Yurien Santos <yurien.santos@informagestudios.com> (https://informagestudios.com)",
  "homepage": "https://incivisme-alertes.informagedevelop.com",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "dev-electron": "quasar dev -m electron",
    "build": "quasar build",
    "build-linux": "quasar build -m electron --target linux",
    "build-mac": "quasar build -m electron --target mac",
    "build-mac-v": "DEBUG=electron-builder quasar build -m electron --target mac",
    "build-mac-vvv": "DEBUG=electron-builder,electron-builder:* quasar build -m electron --target mac",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@quasar/extras": "^1.16.4",
    "auto-launch": "^5.0.6",
    "electron-log": "^5.4.4",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "vue": "^3.4.18",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/packager": "^18.3.6",
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.0.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "vite-plugin-checker": "^0.8.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
